# Endereço público do site (sem barra no fim). Em produção use https://
BASE_URL=http://localhost:3000
PORT=3000
# Por padrão o servidor só atende este computador (127.0.0.1). Para abrir o site no celular, no mesmo Wi-Fi,
# use HOST=0.0.0.0 e acesse http://<IP do computador>:<PORT>. Em produção, atrás do proxy, deixe sem.
# HOST=0.0.0.0

# A única conta do painel (/admin). Use uma senha longa e só sua: 10 caracteres ou mais.
ADMIN_USER=admin
ADMIN_PASSWORD=

# 1 quando o site roda atrás de um proxy (Caddy, Nginx) na mesma máquina
TRUST_PROXY=0
