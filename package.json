{
  "name": "castelo-convite",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Convite interativo com confirmação de presença (castelo 3D + painel)",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "node --watch server/index.js",
    "dev:web": "vite",
    "build": "vite build && node scripts/precompress.js",
    "start": "NODE_ENV=production node server/index.js",
    "seed:dev": "node scripts/seed-dev.js",
    "models": "sh scripts/export-models.sh"
  },
  "dependencies": {
    "@hono/node-server": "^1.13.7",
    "hono": "^4.6.14"
  },
  "devDependencies": {
    "@fontsource/cormorant-garamond": "^5.1.0",
    "@fontsource/great-vibes": "^5.1.0",
    "detect-gpu": "^5.0.70",
    "three": "^0.171.0",
    "vite": "^6.0.5"
  }
}
